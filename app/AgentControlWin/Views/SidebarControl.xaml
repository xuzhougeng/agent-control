<UserControl
    x:Class="AgentControlWin.Views.SidebarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgentControlWin.Views"
    xmlns:core="using:AgentControlWin.Core"
    xmlns:conv="using:AgentControlWin.Converters"
    Background="Transparent">

    <UserControl.Resources>
        <conv:OnlineToBrushConverter x:Key="OnlineToBrush"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4,8,8">
        <StackPanel Spacing="8">

            <!-- Servers section -->
            <Border Background="{StaticResource SurfaceStrongBrush}"
                    CornerRadius="{StaticResource PanelCornerRadius}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Padding="10">
                <StackPanel Spacing="7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SERVERS" FontSize="10" FontWeight="SemiBold"
                                   CharacterSpacing="80" Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}"
                                CornerRadius="8" Padding="5,1" Margin="0,0,4,0">
                            <TextBlock x:Name="ServerCountBadge" Text="0" FontSize="10"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                        <Button Grid.Column="2" x:Name="RefreshServersButton"
                                Click="RefreshServers_Click"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="Refresh servers">
                            <FontIcon Glyph="&#xE72C;" FontSize="11"/>
                        </Button>
                    </Grid>

                    <ItemsControl x:Name="ServersList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="core:Server">
                                <Button Click="ServerItem_Click" Tag="{x:Bind ServerId}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,4"
                                        Style="{StaticResource ListItemButtonStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="7" Height="7" Margin="0,0,8,0"
                                                 Fill="{x:Bind IsOnline, Converter={StaticResource OnlineToBrush}}"
                                                 VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind ServerId}"
                                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Border CornerRadius="6" Padding="4,1"
                                                        BorderThickness="1"
                                                        BorderBrush="#806C4AB6"
                                                        Background="#1A6C4AB6"
                                                        ToolTipService.ToolTip="cc-agent runtime (native Go agent, not cc-proxy PTY wrapper)"
                                                        Visibility="{x:Bind IsCCAgent, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="cc-agent" FontSize="9" FontWeight="SemiBold"
                                                               Foreground="#6C4AB6"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Hostname}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" CornerRadius="8" Padding="5,1"
                                                Background="{x:Bind IsOnline, Converter={StaticResource OnlineToBrush}}"
                                                Opacity="0.15">
                                            <TextBlock Text="{x:Bind Status}" FontSize="9"
                                                       Foreground="{x:Bind IsOnline, Converter={StaticResource OnlineToBrush}}"/>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="NoServersText" Text="No servers found"
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Sessions section -->
            <Border Background="{StaticResource SurfaceStrongBrush}"
                    CornerRadius="{StaticResource PanelCornerRadius}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Padding="10">
                <StackPanel Spacing="7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SESSIONS" FontSize="10" FontWeight="SemiBold"
                                   CharacterSpacing="80" Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}"
                                CornerRadius="8" Padding="5,1" Margin="0,0,4,0">
                            <TextBlock x:Name="SessionCountBadge" Text="0" FontSize="10"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                        <Button Grid.Column="2" x:Name="NewSessionButton"
                                Click="NewSession_Click"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="New Session"
                                Margin="0,0,4,0">
                            <FontIcon Glyph="&#xE710;" FontSize="11"/>
                        </Button>
                        <Button Grid.Column="3" x:Name="RefreshSessionsButton"
                                Click="RefreshSessions_Click"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="Refresh sessions">
                            <FontIcon Glyph="&#xE72C;" FontSize="11"/>
                        </Button>
                    </Grid>

                    <StackPanel x:Name="SessionsRunningGroup" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="RUNNING" FontSize="9" CharacterSpacing="80"
                                   Foreground="{StaticResource TextSoftBrush}"/>
                        <ItemsControl x:Name="RunningSessionsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:Session">
                                    <local:SessionRowControl
                                        SessionData="{x:Bind}"
                                        Margin="0,0,0,4"
                                        SessionClicked="SessionRow_Click"
                                        SessionStopClicked="SessionRow_Stop"
                                        SessionDeleteClicked="SessionRow_Delete"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="SessionsStoppedGroup" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="STOPPED" FontSize="9" CharacterSpacing="80"
                                   Foreground="{StaticResource TextSoftBrush}"/>
                        <ItemsControl x:Name="StoppedSessionsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:Session">
                                    <local:SessionRowControl
                                        SessionData="{x:Bind}"
                                        Margin="0,0,0,4"
                                        SessionClicked="SessionRow_Click"
                                        SessionStopClicked="SessionRow_Stop"
                                        SessionDeleteClicked="SessionRow_Delete"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock x:Name="NoSessionsText"
                               Text="No sessions. Click + to create one."
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Approvals section -->
            <Border x:Name="ApprovalsBorder"
                    Background="{StaticResource SurfaceStrongBrush}"
                    CornerRadius="{StaticResource PanelCornerRadius}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Padding="10"
                    Visibility="Collapsed">
                <StackPanel Spacing="7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="APPROVALS" FontSize="10" FontWeight="SemiBold"
                                   CharacterSpacing="80" Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="{StaticResource WarningSoftBrush}"
                                CornerRadius="8" Padding="5,1">
                            <TextBlock x:Name="ApprovalCountBadge" Text="0" FontSize="10"
                                       Foreground="{StaticResource WarningBrush}"/>
                        </Border>
                    </Grid>
                    <ItemsControl x:Name="ApprovalsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="core:SessionEvent">
                                <Border Background="{StaticResource WarningSoftBrush}"
                                        CornerRadius="{StaticResource SmallCornerRadius}"
                                        BorderBrush="{StaticResource WarningBrush}"
                                        BorderThickness="1"
                                        Padding="8,6"
                                        Margin="0,0,0,4">
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{x:Bind SessionId}"
                                                           FontFamily="Cascadia Code, Consolas"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Border CornerRadius="6" Padding="4,1"
                                                        BorderThickness="1"
                                                        BorderBrush="#806C4AB6"
                                                        Background="#1A6C4AB6"
                                                        ToolTipService.ToolTip="cc-agent destructive command awaiting approval"
                                                        Visibility="{x:Bind IsFromCCAgent, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="cc-agent" FontSize="9" FontWeight="SemiBold"
                                                               Foreground="#6C4AB6"/>
                                                </Border>
                                            </StackPanel>
                                            <Button Grid.Column="1" Tag="{x:Bind EventId}"
                                                    Click="ApproveButton_Click"
                                                    Background="{StaticResource SuccessBrush}"
                                                    Foreground="White"
                                                    FontSize="10" Padding="6,2" Margin="2,0"
                                                    CornerRadius="4"
                                                    Content="✓"/>
                                            <Button Grid.Column="2" Tag="{x:Bind EventId}"
                                                    Click="RejectButton_Click"
                                                    Background="{StaticResource DangerBrush}"
                                                    Foreground="White"
                                                    FontSize="10" Padding="6,2"
                                                    CornerRadius="4"
                                                    Content="✕"/>
                                        </Grid>
                                        <TextBlock Text="{x:Bind PromptExcerpt}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   MaxLines="2"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
