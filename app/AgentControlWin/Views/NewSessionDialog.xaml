<ContentDialog
    x:Class="AgentControlWin.Views.NewSessionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="New Session"
    PrimaryButtonText="Create"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    Background="{StaticResource SurfaceBrush}">

    <StackPanel Spacing="12" MinWidth="360">

        <!-- Server -->
        <StackPanel Spacing="4">
            <TextBlock Text="Server" FontSize="11" Foreground="{StaticResource TextSoftBrush}"/>
            <TextBlock x:Name="ServerIdText"
                       Text="(none)"
                       FontFamily="Cascadia Code, Consolas, Courier New"
                       FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}"/>
        </StackPanel>

        <!-- Session Type -->
        <StackPanel Spacing="4">
            <TextBlock Text="Session Type" FontSize="11" Foreground="{StaticResource TextSoftBrush}"/>
            <ComboBox x:Name="SessionTypeCombo" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="PTY (Terminal)" IsSelected="True" Tag="pty"/>
                <ComboBoxItem Content="Chat" Tag="chat"/>
            </ComboBox>
        </StackPanel>

        <!-- Working Directory -->
        <StackPanel Spacing="4">
            <TextBlock Text="Working Directory *" FontSize="11" Foreground="{StaticResource TextSoftBrush}"/>
            <TextBox x:Name="CwdBox"
                     PlaceholderText="/path/to/repo"
                     FontFamily="Cascadia Code, Consolas, Courier New"
                     FontSize="12"
                     TextChanged="CwdBox_TextChanged"/>
        </StackPanel>

        <!-- Allowed Roots (hint) -->
        <StackPanel x:Name="AllowedRootsPanel" Spacing="4" Visibility="Collapsed">
            <TextBlock Text="Allowed Roots (click to fill)"
                       FontSize="11" Foreground="{StaticResource TextSoftBrush}"/>
            <ItemsControl x:Name="AllowedRootsItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}"
                                Click="AllowedRoot_Click"
                                Tag="{Binding}"
                                HorizontalAlignment="Left"
                                Margin="0,2"
                                Padding="6,2"
                                CornerRadius="4"
                                FontFamily="Cascadia Code, Consolas, Courier New"
                                FontSize="11"
                                Foreground="{StaticResource AccentBrush}"
                                Background="{StaticResource AccentSoftBrush}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Session ID (optional) -->
        <StackPanel Spacing="4">
            <TextBlock Text="Session ID (optional)" FontSize="11" Foreground="{StaticResource TextSoftBrush}"/>
            <TextBox x:Name="SessionIdBox"
                     PlaceholderText="UUID to reuse for this session"
                     FontFamily="Cascadia Code, Consolas, Courier New"
                     FontSize="12"/>
        </StackPanel>

        <!-- Environment Variables -->
        <StackPanel Spacing="4">
            <TextBlock Text="Environment Variables (KEY=VALUE, comma-separated)"
                       FontSize="11" Foreground="{StaticResource TextSoftBrush}"/>
            <TextBox x:Name="EnvBox"
                     PlaceholderText="CC_PROFILE=dev,MY_KEY=value"
                     FontSize="12"/>
        </StackPanel>

        <!-- Error -->
        <TextBlock x:Name="ErrorText"
                   Foreground="{StaticResource DangerBrush}"
                   FontSize="11"
                   Visibility="Collapsed"
                   TextWrapping="Wrap"/>

    </StackPanel>
</ContentDialog>
