<Window
    x:Class="AgentControlWin.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgentControlWin.Views"
    Title="Agent Control">

    <Grid Background="{StaticResource BgBaseBrush}">
        <Grid.ColumnDefinitions>
            <!-- Sidebar pane -->
            <ColumnDefinition Width="260" MinWidth="220" MaxWidth="340"/>
            <!-- Splitter -->
            <ColumnDefinition Width="1"/>
            <!-- Main content -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0"
              Background="{StaticResource BgBaseBrush}">
            <Grid.RowDefinitions>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Nav buttons -->
                <RowDefinition Height="Auto"/>
                <!-- Scrollable content: servers + sessions + approvals -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Branding header -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceStrongBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Agent Control"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="NATIVE WORKSPACE"
                                   FontSize="9" CharacterSpacing="120"
                                   Foreground="{StaticResource TextSoftBrush}"/>
                    </StackPanel>
                    <!-- WS status indicator -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Ellipse x:Name="WsIndicator" Width="8" Height="8"/>
                        <Button x:Name="SettingsNavBtn"
                                Click="SettingsBtn_Click"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="Settings">
                            <FontIcon Glyph="&#xE713;" FontSize="13"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page nav buttons (Terminal / Chat) -->
            <Border Grid.Row="1"
                    Background="{StaticResource SurfaceStrongBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="10,8">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="TerminalNavBtn"
                            Grid.Column="0"
                            Content="Terminal"
                            Click="TerminalNav_Click"
                            HorizontalAlignment="Stretch"
                            Padding="0,6"
                            CornerRadius="{StaticResource SmallCornerRadius}"
                            Background="{StaticResource AccentBrush}"
                            Foreground="White"
                            FontSize="12" FontWeight="SemiBold"/>
                    <Button x:Name="ChatNavBtn"
                            Grid.Column="1"
                            Content="Chat"
                            Click="ChatNav_Click"
                            HorizontalAlignment="Stretch"
                            Padding="0,6"
                            CornerRadius="{StaticResource SmallCornerRadius}"
                            Background="{StaticResource SurfaceStrongBrush}"
                            Foreground="{StaticResource TextMutedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            FontSize="12" FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <!-- Sidebar content (servers / sessions / approvals) -->
            <local:SidebarControl x:Name="Sidebar"
                                  Grid.Row="2"/>
        </Grid>

        <!-- Vertical divider -->
        <Rectangle Grid.Column="1" Fill="{StaticResource BorderBrush}" Width="1"/>

        <!-- Main content frame -->
        <Frame x:Name="ContentFrame"
               Grid.Column="2"
               Background="{StaticResource SurfaceBrush}"/>
    </Grid>
</Window>
